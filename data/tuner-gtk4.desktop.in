[Desktop Entry]
Type=Application
Name=Tuner
GenericName=Internet streaming radio music player
Comment=Listen to Radio Stations from around the world
Categories=AudioVideo;Audio;Player;
Exec=tuner-gtk4
Icon=@APP_ID@
Terminal=false
Keywords=Radio;Receiver;FM;Music;Talk;Sport;News
SingleMainWindow=true
