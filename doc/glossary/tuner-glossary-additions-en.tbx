<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE martif PUBLIC "ISO 12200:1999A//DTD MARTIF core (DXFcdV04)//EN" "TBXcdv04.dtd">
<martif type="TBX" xml:lang="en">
    <martifHeader>
        <fileDesc>
            <sourceDesc>
                <p>Tuner glossary additions</p>
            </sourceDesc>
        </fileDesc>
    </martifHeader>
    <text>
        <body>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Stream</term></tig></langSet>
                <note from="developer">The audio feed of a station that Tuner plays.</note>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Directory</term></tig></langSet>
                <note from="developer">The online catalogue of stations (radio-browser) that Tuner connects to.</note>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Star</term></tig></langSet>
                <note from="developer">To mark a station as a favourite. Unstar reverses it. Related: Starred.</note>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Hearted</term></tig></langSet>
                <note from="developer">A track the user marked with a heart while it played.</note>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Heart</term></tig></langSet>
                <note from="developer">To mark the playing track as a favourite. The ♥ symbol is kept.</note>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>All Time</term></tig></langSet>
                <note from="developer">The list of hearted tracks kept permanently, across sessions.</note>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Stream info</term></tig></langSet>
                <note from="developer">The title, artist and other details a station sends about what it is playing.</note>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Metadata</term></tig></langSet>
                <note from="developer">Data sent with a stream, such as the track title and images. Related: Stream Metadata.</note>
            </termEntry>
            <termEntry>
                <langSet xml:lang="en"><tig><term>Share stream URI</term></tig></langSet>
                <note from="developer">Offer a station's stream address to others, as text or a QR code.</note>
            </termEntry>
        </body>
    </text>
</martif>
